# HOW TO USE THIS FILE
# 1. Make a copy of this file and name the copy .env.local (same folder).
# 2. Fill in every value in .env.local. Never put real keys in this file.
# 3. .env.local is ignored by git, so your secrets are never uploaded.
# 4. Restart "npm run dev" after you change .env.local.

# Supabase project URL. Safe to be public.
# Find it: Supabase dashboard > open your project > Project Settings > Data API (or the Connect button at the top).
# It looks like https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon (public) key. Safe to be public; row level security protects the data.
# Find it: Supabase dashboard > Project Settings > API Keys, the key labelled "anon" / "public"
# (newer projects call it the "Publishable key").
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service-role key. SECRET: it bypasses all security. Server only, never share it or commit it.
# Find it: Supabase dashboard > Project Settings > API Keys, the key labelled "service_role"
# (newer projects call it the "Secret key"). Click Reveal, then copy.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The Gmail address that sends the booking confirmation emails, for example ccf.rooms@gmail.com.
GMAIL_USER=your-address@gmail.com

# A Gmail App Password (NOT your normal Gmail password). SECRET.
# Create it: Google Account > Security > turn on 2-Step Verification, then search for "App passwords",
# create one named "ccf-booking", and paste the 16 letters here without spaces.
GMAIL_APP_PASSWORD=your-16-letter-app-password

# Emails allowed to log in as admin. Separate several with commas, no spaces needed.
# Use the same emails as the admin users you create in Supabase > Authentication > Users.
ADMIN_EMAILS=admin1@example.com,admin2@example.com

# The public web address of this site, with no slash at the end.
# Use http://localhost:3000 while developing, and your Vercel address (https://your-app.vercel.app) once deployed.
# It is used to build the "cancel booking" link in emails.
SITE_URL=http://localhost:3000
