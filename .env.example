# Copy this file to .env.local and fill in the real values. Never commit .env.local.
# On Vercel, add every variable below under Settings > Environment Variables.

# Supabase > Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=
# Supabase > Project Settings > API > anon public key
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase > Project Settings > API > service_role key. Server only, keep it secret.
SUPABASE_SERVICE_ROLE_KEY=

# The Gmail address that sends booking emails
GMAIL_USER=
# A Gmail App Password for that address (not the normal Gmail password)
GMAIL_APP_PASSWORD=

# Comma-separated admin emails. Each one must also exist as a Supabase user.
ADMIN_EMAILS=

# Public address of the site, no trailing slash. Cancel links in emails use it.
# Local: http://localhost:3000   Production: https://<project>.vercel.app
SITE_URL=
